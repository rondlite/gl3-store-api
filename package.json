{
  "name": "gl3-store-api",
  "version": "0.1.0",
  "private": true,
  "description": "Auth and entitlement API backing the verdaccio-auth-gl3 registry plugin",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "catalog": "tsx src/catalog-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "1.14.1",
    "@hono/zod-validator": "0.4.3",
    "hono": "4.7.7",
    "pg": "8.14.1",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "@types/pg": "8.11.13",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
