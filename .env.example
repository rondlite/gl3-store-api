# Postgres connection string.
DATABASE_URL=postgres://gl3:gl3@localhost:5432/gl3_store

# Shared secret between this API and the Verdaccio auth-gl3 plugin. The registry
# reads the same value from its own INTERNAL_API_KEY. Minimum 32 chars.
# Generate one with: openssl rand -base64 48
INTERNAL_API_KEY=

PORT=8080
LOG_LEVEL=info

# Premium is disabled when all of these settings are absent. Set the whole group
# together to enable it. Use Stripe TEST mode until the launch checks pass.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_PRICE_ID=price_...        # EUR 49/year, tax_behavior=inclusive
# STRIPE_FIRST_YEAR_PRICE_ID=price_...     # EUR 20 once, tax_behavior=inclusive
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_... # cancellation at period end, no plan changes
# PREMIUM_TOKEN_KEY=...                  # 32 random bytes, encoded as 64 hex characters
# RESEND_API_KEY=re_...
# PREMIUM_EMAIL_FROM=premium@your-verified-domain.example
# PUBLIC_ORIGIN=https://gl3.dev
