# Postgres connection string.
DATABASE_URL=postgres://gl3:gl3@localhost:5432/gl3_store

# Shared secret between this API and the Verdaccio auth-gl3 plugin. The registry
# reads the same value from its own INTERNAL_API_KEY. Minimum 32 chars.
# Generate one with: openssl rand -base64 48
INTERNAL_API_KEY=

PORT=8080
LOG_LEVEL=info
